{"id": 195, "word": "乐极生悲", "chapter_id": 126, "chapter_title": "滑稽列传", "pn": "5", "quote": "酒极则乱，乐极则悲", "meaning": "快乐到极点转为悲伤", "context": "故曰酒极则乱，乐极则悲；"}
{"id": 196, "word": "杯盘狼藉", "chapter_id": 126, "chapter_title": "滑稽列传", "pn": "5", "quote": "杯盘狼藉", "meaning": "宴会后的杂乱景象", "context": "日暮酒阑，合尊促坐，男女同席，履舄交错，杯盘狼藉，堂上烛灭，主人留髡而送客，罗襦襟解，微闻芗泽，当此之时，髡心最欢，能饮一石。"}
{"id": 197, "word": "一家之言", "chapter_id": 130, "chapter_title": "太史公自序", "pn": "171", "quote": "", "meaning": "", "context": "序略，以拾遗补，成一家之言，厥协六经异传，整齐百家杂语，藏之名山，副在京师，俟後世圣人君子。"}
{"id": 198, "word": "不可胜数", "chapter_id": 130, "chapter_title": "太史公自序", "pn": "31", "quote": "", "meaning": "", "context": "春秋之中，弑君三十六，亡国五十二，诸侯奔走不得保其社稷者不可胜数。"}
{"id": 199, "word": "不可胜道", "chapter_id": 130, "chapter_title": "太史公自序", "pn": "36", "quote": "", "meaning": "", "context": "汉兴以来，至明天子，获符瑞，封禅，改正朔，易服色，受命於穆清，泽流罔极，海外殊俗，重译款塞，请来献见者，不可胜道。"}
{"id": 200, "word": "世易时移", "chapter_id": 130, "chapter_title": "太史公自序", "pn": "12", "quote": "夫世异时移，事业不必同，故曰“俭而难遵”。", "meaning": "", "context": "夫世异时移，事业不必同，故曰“俭而难遵”。"}
{"id": 201, "word": "九合诸侯", "chapter_id": 130, "chapter_title": "太史公自序", "pn": "70", "quote": "", "meaning": "", "context": "不背柯盟，桓公以昌，九合诸侯，霸功显彰。"}
{"id": 202, "word": "名山大川", "chapter_id": 130, "chapter_title": "太史公自序", "pn": "66", "quote": "", "meaning": "", "context": "追本诸神名山大川礼，作封禅书第六。"}
{"id": 203, "word": "失之豪釐，差以千里", "chapter_id": 130, "chapter_title": "太史公自序", "pn": "31", "quote": "", "meaning": "", "context": "故易曰‘失之豪釐，差以千里’。"}
{"id": 204, "word": "家给人足", "chapter_id": 130, "chapter_title": "太史公自序", "pn": "12", "quote": "", "meaning": "", "context": "要曰彊本节用，则人给家足之道也。"}
{"id": 205, "word": "春生夏长，秋收冬藏", "chapter_id": 130, "chapter_title": "太史公自序", "pn": "10", "quote": "", "meaning": "", "context": "夫春生夏长，秋收冬藏，此天道之大经也，弗顺则无以为天下纲纪，故曰“四时之大顺，不可失也”。"}
{"id": 206, "word": "殊途同归", "chapter_id": 130, "chapter_title": "太史公自序", "pn": "7", "quote": "", "meaning": "", "context": "易大传：“天下一致而百虑，同归而殊涂。"}
{"id": 207, "word": "移风易俗", "chapter_id": 130, "chapter_title": "太史公自序", "pn": "62", "quote": "", "meaning": "", "context": "乐者，所以移风易俗也。"}
{"id": 208, "word": "舍本逐末", "chapter_id": 130, "chapter_title": "太史公自序", "pn": "68", "quote": "", "meaning": "", "context": "其极则玩巧，并兼兹殖，争於机利，去本趋末。"}
{"id": 209, "word": "讷言敏行", "chapter_id": 130, "chapter_title": "太史公自序", "pn": "141", "quote": "", "meaning": "", "context": "敦厚慈孝，讷於言，敏於行，务在鞠躬，君子长者。"}
{"id": 210, "word": "运筹帷幄", "chapter_id": 130, "chapter_title": "太史公自序", "pn": "93", "quote": "", "meaning": "", "context": "运筹帷幄之中，制胜於无形，子房计谋其事，无知名，无勇功，图难於易，为大於细。"}
{"id": 211, "word": "顺之者昌，逆之者亡", "chapter_id": 130, "chapter_title": "太史公自序", "pn": "10", "quote": "", "meaning": "", "context": "夫阴阳四时、八位、十二度、二十四节各有教令，顺之者昌，逆之者不死则亡，未必然也，故曰“使人拘而多畏”。"}
{"id": 212, "word": "风起云蒸", "chapter_id": 130, "chapter_title": "太史公自序", "pn": "86", "quote": "", "meaning": "", "context": "秦失其政，而陈涉发迹，诸侯作难，风起云蒸，卒亡秦族。"}
